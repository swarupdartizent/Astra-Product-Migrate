# OIDC provider (Keycloak realm in the local stack). All values are public; no secrets here.
VITE_OIDC_AUTHORITY=http://localhost:18080/realms/astra
VITE_OIDC_CLIENT_ID=astra-web
# Defaults to <origin>/auth/callback when unset.
VITE_OIDC_REDIRECT_URI=http://localhost:5273/auth/callback
# acr_values requested when the API says multi-factor sign-in is required (step-up).
# Leave empty to send only prompt=login.
VITE_OIDC_MFA_ACR_VALUES=
